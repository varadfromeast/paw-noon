{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pawnoon.app/schemas/room-join.waiting.schema.json",
  "title": "202 from room-join: the host has not recorded yet (200 is a match-start response with status ready + room)",
  "type": "object",
  "required": [
    "status",
    "code",
    "hostName",
    "expiresAt",
    "pollAfterSec"
  ],
  "properties": {
    "status": {
      "const": "waiting"
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z]{4}$"
    },
    "hostName": {
      "type": "string"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "Stop polling after this."
    },
    "pollAfterSec": {
      "type": "integer",
      "description": "3"
    }
  }
}
