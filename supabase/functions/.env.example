# Copy to supabase/functions/.env.local for `supabase functions serve --env-file supabase/functions/.env.local`.
# In production set these with `supabase secrets set KEY=value` (SUPABASE_* are injected automatically).

# Ranked seasons are weekly (ISO week, ratings.season = YYYYWW, board ranked_YYYY_WW). Set PN_SEASON to a
# positive integer only to pin one fixed season (ops override; board ranked_season_N).
# PN_SEASON=
# Client builds allowed in ranked, comma separated; "*" = any build. Empty = ranked closed.
PN_RANKED_BUILDS=*
# Calendar day for the daily bounty.
PN_DAY_TZ=Asia/Kolkata
# LOCAL ONLY: guests may play ranked (no Apple/Google against supabase start).
PN_RANKED_ALLOW_GUESTS=true
# LOCAL ONLY: accept inputSource "injected" (ReviewDirector smoke test).
PN_ALLOW_INJECTED=true
# LOCAL ONLY: serve new recordings to strangers at once (production quarantines them for 2 of the owner's
# further clean matches; the M4 smoke test step 3 needs 0).
PN_QUARANTINE_MATCHES=0
# Ranked recordings must carry raw swipe samples (A3). Leave unset until the client sends them.
# PN_REQUIRE_SAMPLES=true

# ---- Payments (M7, Docs/PAYMENTS.md). Without these, purchase-validate answers 503 store_not_configured
# ---- (except Apple receipts, which fall back to verifyReceipt and need no secret for a non-consumable).
# App Store: bundle id, App Store Server API In-App Purchase key (App Store Connect > Users and Access >
# Integrations > In-App Purchase). APPLE_PRIVATE_KEY is the .p8 file's contents ("\n" escapes are fine).
APPLE_BUNDLE_ID=com.pawnoon.pixel
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Optional: app-specific shared secret, sent as the verifyReceipt password (fallback path only).
APPLE_SHARED_SECRET=
# Google Play: package name and the service-account key JSON (one line) with access to the app in Play Console.
GOOGLE_PACKAGE_NAME=com.pawnoon.pixel
GOOGLE_SERVICE_ACCOUNT_JSON=
# Accept sandbox / license-tester purchases (keep true: App Review buys in the sandbox).
PN_IAP_ALLOW_SANDBOX=true
# Acknowledge Google purchases server-side (Google refunds unacknowledged ones after 3 days).
PN_GOOGLE_ACKNOWLEDGE=true
